<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/cardSystemItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="54dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <!-- Device Type Icon (laptop, headphones, generic) -->
        <ImageView
            android:id="@+id/ivSystemIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_laptop"
            android:contentDescription="Device"
            android:tint="@color/text_secondary" />

        <!-- Name & Detail Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSystemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Name"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvSystemIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Subtext"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Connect Action Button (replaces the (i) info button) -->
        <TextView
            android:id="@+id/tvSystemActionBadge"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/btn_device_connect_bg"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Connect"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Optional Delete Button for Saved History -->
        <ImageView
            android:id="@+id/btnSystemDelete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_trash"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Subtle Inset Divider (aligned with text) -->
    <View
        android:id="@+id/dividerBottom"
        android:layout_width="match_parent"
        android:layout_height="0.8dp"
        android:layout_marginStart="52dp"
        android:background="@color/surface_border_subtle" />
</LinearLayout>
