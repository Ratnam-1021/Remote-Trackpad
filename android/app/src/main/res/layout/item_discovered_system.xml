<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardSystemItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dock_btn_normal"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/icon_squircle_bg">

        <ImageView
            android:id="@+id/ivSystemIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_laptop"
            android:contentDescription="Computer" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSystemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Computer"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSystemIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="10.90.63.215 · 8765"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSystemActionBadge"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:background="@drawable/status_pill_bg"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:text="CONNECT"
        android:textColor="@color/success_green"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/btnSystemDelete"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="6dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_trash"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete saved device"
        android:visibility="gone" />
</LinearLayout>
